{
  "manifestVersion": 1,
  "id": "c4143-dvscale-dashboard",
  "version": "1.2.0",
  "name": "C9A16 Building Block Dashboard",
  "description": "Read-only Building Block Test Case statistics, Test Results, XLSX reports and snapshot changes inside Azure DevOps.",
  "publisher": "alan512627",
  "public": false,
  "categories": ["Azure Boards", "Azure Test Plans"],
  "targets": [
    { "id": "Microsoft.VisualStudio.Services" }
  ],
  "icons": {
    "default": "img/icon.svg"
  },
  "scopes": ["vso.work", "vso.test"],
  "demands": ["environment/cloud", "contribution/ms.vss-dashboards-web.widget-catalog"],
  "contributions": [
    {
      "id": "c4143-dashboard-hub",
      "type": "ms.vss-web.hub",
      "targets": ["ms.vss-test-web.test-hub-group"],
      "properties": {
        "name": "C9A16 Building Block",
        "order": 90,
        "uri": "dist/dashboard.html",
        "supportsMobile": true
      }
    },
    {
      "id": "c4143-summary-widget",
      "type": "ms.vss-dashboards-web.widget",
      "targets": ["ms.vss-dashboards-web.widget-catalog"],
      "properties": {
        "name": "C9A16 Building Block Status",
        "description": "Live Building Block Test Case state summary with a link to the full dashboard.",
        "catalogIconUrl": "img/icon.svg",
        "uri": "dist/widget.html",
        "isNameConfigurable": true,
        "supportedSizes": [
          { "rowSpan": 2, "columnSpan": 2 },
          { "rowSpan": 2, "columnSpan": 3 },
          { "rowSpan": 3, "columnSpan": 4 }
        ],
        "supportedScopes": ["project_team"]
      }
    }
  ],
  "files": [
    { "path": "dist", "addressable": true },
    { "path": "img", "addressable": true },
    { "path": "README.md", "addressable": true }
  ]
}
